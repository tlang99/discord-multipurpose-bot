# Copy to .env (never committed) next to docker-compose.yml and fill it in. These are the bot's secrets; everything
# else can stay in appsettings.json.

# The bot's token (Discord Developer Portal > your app > Bot > Reset Token).
BOT_TOKEN=
# Optional: a second account that plays the music, so voice listening and music can run at once (voice/README.md).
MUSIC_BOT_TOKEN=

# Lavalink's password, shared by the bot and Lavalink. Lavalink isn't reachable from outside the compose network, so
# the default works; change it if you like.
LAVALINK_PASSWORD=youshallnotpass

# Optional: web search (an ollama.com key) and image moderation (Sightengine).
OLLAMA_SEARCH_API_KEY=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# The chat model the ollama-pull service downloads. Chat:Model in appsettings.json has to match.
OLLAMA_MODEL=llama3.2

# Your time zone, for log times and reminders without a time zone of their own (e.g. America/New_York).
TZ=America/New_York
