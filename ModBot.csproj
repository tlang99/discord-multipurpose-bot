<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>7e2b6c6f-3b0f-4b9a-9b9e-modbot-secrets</UserSecretsId>
    <!-- The test project lives under tests/ and the tools under tools/; keep their files (and bin/obj) out of the bot. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;tools/**;discord-net-patch/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <!-- 3.20.2 plus an unreleased voice-encryption fix, from discord-net-patch/ (see build.ps1 there). Drop these three
         once a Discord.Net release has the fix. -->
    <PackageReference Include="Discord.Net.Core" Version="3.20.2.1" />
    <PackageReference Include="Discord.Net.Rest" Version="3.20.2.1" />
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.2.1" />
    <PackageReference Include="Lavalink4NET.Discord.NET" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.InactivityTracking" Version="4.2.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <!-- Voice commands: speech-to-text on this machine. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <!-- The patched Discord.Net is built locally, not committed: say how, rather than leave a NuGet error. All four
       packages, so a half-built folder (an interrupted build.ps1) gets this message too. -->
  <PropertyGroup>
    <PatchedDiscordNet>$(MSBuildThisFileDirectory)discord-net-patch/packages/</PatchedDiscordNet>
  </PropertyGroup>
  <Target Name="CheckPatchedDiscordNet" BeforeTargets="Restore;CollectPackageReferences"
          Condition="!Exists('$(PatchedDiscordNet)Discord.Net.Core.3.20.2.1.nupkg') Or !Exists('$(PatchedDiscordNet)Discord.Net.Rest.3.20.2.1.nupkg') Or !Exists('$(PatchedDiscordNet)Discord.Net.WebSocket.3.20.2.1.nupkg') Or !Exists('$(PatchedDiscordNet)Discord.Net.Dave.3.20.2.1.nupkg')">
    <Error Text="Build the patched Discord.Net first, once: powershell -ExecutionPolicy Bypass -File discord-net-patch/build.ps1 (pwsh on Linux/macOS). See discord-net-patch/build.ps1 for why." />
  </Target>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Voice commands: libdave, libsodium and opus, which Discord.Net loads from next to the exe. Downloaded by
         voice/setup.ps1, not committed; without them only voice commands are unavailable. -->
    <None Include="voice/natives/*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
