<?xml version="1.0" encoding="utf-8"?>
<!-- Discord.Net 3.20.2 with an unreleased voice-encryption fix, built by discord-net-patch/build.ps1. Remove this file
     with that folder once a Discord.Net release includes the fix. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="discord-net-patch" value="discord-net-patch/packages" />
  </packageSources>
  <!-- The patched packages come only from the local build, never from nuget.org, even if someone publishes a package
       there with the same name and version. Everything else comes only from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="discord-net-patch">
      <package pattern="Discord.Net.Core" />
      <package pattern="Discord.Net.Rest" />
      <package pattern="Discord.Net.WebSocket" />
      <package pattern="Discord.Net.Dave" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
