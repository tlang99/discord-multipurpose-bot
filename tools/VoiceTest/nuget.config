<?xml version="1.0" encoding="utf-8"?>
<!-- The voice test uses a patched Discord.Net (see build-discord-net.ps1), built into packages/ here. Only this tool
     sees it: the bot itself uses the official packages. -->
<configuration>
  <packageSources>
    <add key="patched-discord-net" value="packages" />
  </packageSources>
</configuration>
